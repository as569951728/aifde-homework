('month', ordered_at)::date as month_start, paid_cents - refund_cents as net_sales_cents\n  from \"data\".\"main\".\"orders\"\n  where status = 'paid' and paid_cents - refund_cents > 0\n)\nselect member_id, month_start, count(*) as valid_order_count, sum(net_sales_cents) as net_sales_cents\nfrom valid_orders\ngroup by member_id, month_start", "relation_name": "\"data\".\"main\".\"monthly_member_order_summary\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T04:01:21.475734Z", "completed_at": "2026-11-09T04:01:21.492849Z"}, {"name": "execute", "started_at": "2026-11-09T04:01:21.493318Z", "completed_at": "2026-11-09T04:01:21.532014Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0573887825012207, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.w03.orders_enriched", "compiled": true, "compiled_code": "with valid_orders as (\n  select order_id, member_id, ordered_at\n  from \"data\".\"main\".\"orders\"\n  where status = 'paid' and paid_cents - refund_cents > 0\n),\nranked as (\n  select order_id,\n         row_number() over (partition by member_id order by ordered_at, order_id) as valid_order_seq\n  from valid_orders\n),\nflags as (\n  select order_id, valid_order_seq,\n         case when valid_order_seq = 1 then true else false end as is_first_valid_order,\n         case when valid_order_seq >= 2 then true else false end as is_repeat_valid_order\n  from ranked\n)\nselect o.order_id, o.member_id, o.store_id, o.ordered_at, o.status, o.gross_cents, o.paid_cents, o.refund_cents, o.quantity, o.channel,\n       o.paid_cents - o.refund_cents as net_sales_cents,\n       f.valid_order_seq,\n       coalesce(f.is_first_valid_order, false) as is_first_valid_order,\n       coalesce(f.is_repeat_valid_order, false) as is_repeat_valid_order\nfrom \"data\".\"main\".\"orders\" o\nleft join flags f on o.order_id = f.order_id", "relation_name": "\"data\".\"main\".\"orders_enriched\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T04:01:21.534797Z", "completed_at": "2026-11-09T04:01:21.552575Z"}, {"name": "execute", "started_at": "2026-11-09T04:01:21.553073Z", "completed_at": "2026-11-09T04:01:21.587694Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05401015281677246, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.w03.member_month_paid_eligibility", "compiled": true, "compiled_code": "with member_months as (\n  select distinct member_id, month_start\n  from \"data\".\"main\".\"monthly_member_order_summary\"\n),\nelig as (\n  select mm.member_id, mm.month_start,\n         case when exists (\n           select 1\n           from \"data\".\"main\".\"cards\" c\n           where c.member_id = mm.member_id\n             and c.card_type in ('\u60a6\u4eab\u5e74\u5361', '\u5bb6\u5ead\u5b63\u5361')\n             and c.valid_from <= (mm.month_start + interval '1 month' - interval '1 day')::date\n             and (mm.month_start + interval '1 month' - interval '1 day')::date < c.valid_until\n             and (c.ended_at is null or (mm.month_start + interval '1 month' - interval '1 day')::date < c.ended_at)\n         ) then true else false end as is_paid_eligible\n  from member_months mm\n)\nselect member_id, month_start, is_paid_eligible from elig", "relation_name": "\"data\".\"main\".\"member_month_paid_eligibility\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T04:01:21.590805Z", "completed_at": "2026-11-09T04:01:21.613008Z"}, {"name": "execute", "started_at": "2026-11-09T04:01:21.613512Z", "completed_at": "2026-11-09T04:01:21.646056Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05634593963623047, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.w03.monthly_paid_member_summary", "compiled": true, "compiled_code": "with summary as (\n  select member_id, month_start, valid_order_count, net_sales_cents\n  from \"data\".\"main\".\"monthly_member_order_summary\"\n),\nelig as (\n  select member_id, month_start, is_paid_eligible\n  from \"data\".\"main\".\"member_month_paid_eligibility\"\n)\nselect s.member_id, s.month_start, s.valid_order_count, s.net_sales_cents, e.is_paid_eligible\nfrom summary s\njoin elig e using (member_id, month_start)", "relation_name": "\"data\".\"main\".\"monthly_paid_member_summary\"", "batch_results": null, "overload_results": null}], "elapsed_time": 24.15496802330017, "args": {"snowflake_projects_otel": false, "log_format_file": "debug", "state_modified_compare_vars": false, "v2_parser": "dbt-core-experimental-parser parse", "indirect_selection": "eager", "send_anonymous_usage_stats": false, "require_valid_schema_from_generate_schema_name": false, "use_v2_parser": false, "require_explicit_package_overrides_for_builtin_materializations": true, "cache_selected_only": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "require_resource_names_without_spaces": true, "require_yaml_configuration_for_mf_time_spines": true, "require_source_and_semantic_model_names_without_spaces": false, "use_catalogs_v2": false, "upload_to_artifacts_ingest_api": false, "log_level_file": "debug", "require_sql_header_in_test_configs": false, "static_parser": true, "require_ref_searches_node_package_before_root": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "require_all_warnings_handled_by_warn_error": true, "log_level": "info", "print": true, "require_nested_cumulative_type_params": true, "partial_parse": true, "state_modified_compare_more_unrendered_values": true, "which": "run", "exclude": [], "quiet": false, "require_batched_execution_for_custom_microbatch_strategy": true, "use_fast_test_edges": false, "macro_debugging": false, "select": [], "allow_j