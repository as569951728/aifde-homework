        "sql": "SELECT\n  MAX(subq_11.first_buyer_count) AS first_buyer_count\n  , MAX(subq_11.first_order_sales_cents) AS first_order_sales_cents\n  , MAX(subq_11.first_order_count) AS first_order_count\n  , MAX(subq_11.repeat_order_count) AS repeat_order_count\n  , MAX(subq_18.valid_order_count) AS valid_order_count\nFROM (\n  SELECT\n    COUNT(DISTINCT CASE WHEN valid_order_seq = 1 THEN member_id END) AS first_buyer_count\n    , SUM(CASE WHEN valid_order_seq = 1 THEN paid_cents - refund_cents ELSE 0 END) AS first_order_sales_cents\n    , SUM(CASE WHEN valid_order_seq = 1 THEN 1 ELSE 0 END) AS first_order_count\n    , SUM(CASE WHEN valid_order_seq >= 2 THEN 1 ELSE 0 END) AS repeat_order_count\n  FROM \"data\".\"main\".\"order_sequence\" order_sequence_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-06-18' AND '2026-06-18'\n) subq_11\nCROSS JOIN (\n  SELECT\n    SUM(CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END) AS valid_order_count\n  FROM \"data\".\"main\".\"orders\" orders_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-06-18' AND '2026-06-18'\n) subq_18",
