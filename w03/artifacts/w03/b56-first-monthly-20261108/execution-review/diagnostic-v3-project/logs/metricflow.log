2026-11-08 23:17:46,935 INFO adapter_backed_client.py:164 [MainThread] - Running query() statement
  statement:
    -- Combine Aggregated Outputs
    -- Write to DataTable
    SELECT
      COALESCE(subq_7.member, subq_15.member) AS member
      , MAX(subq_7.first_buyer_count) AS first_buyer_count
      , MAX(subq_7.first_order_sales_cents) AS first_order_sales_cents
      , MAX(subq_7.first_order_count) AS first_order_count
      , MAX(subq_7.repeat_order_count) AS repeat_order_count
      , MAX(subq_15.valid_order_count) AS valid_order_count
    FROM (
      -- Constrain Output with WHERE
      -- Select: ['__first_buyer_count', '__first_order_sales_cents', '__first_order_count', '__repeat_order_count', 'member']
      -- Aggregate Inputs for Simple Metrics
      -- Compute Metrics via Expressions
      SELECT
        member
        , COUNT(DISTINCT first_buyer_count) AS first_buyer_count
        , SUM(first_order_sales_cents) AS first_order_sales_cents
        , SUM(first_order_count) AS first_order_count
        , SUM(repeat_order_count) AS repeat_order_count
      FROM (
        -- Read Elements From Semantic Model 'order_sequence'
        -- Metric Time Dimension 'ordered_at'
        -- Constrain Time Range to [2026-08-01T00:00:00, 2026-08-31T00:00:00]
        -- Select: ['__first_buyer_count', '__first_order_sales_cents', '__first_order_count', '__repeat_order_count', 'member']
        SELECT
          member_id AS member
          , CASE WHEN valid_order_seq = 1 THEN member_id END AS first_buyer_count
          , CASE WHEN valid_order_seq = 1 THEN paid_cents - refund_cents ELSE 0 END AS first_order_sales_cents
          , CASE WHEN valid_order_seq = 1 THEN 1 ELSE 0 END AS first_order_count
          , CASE WHEN valid_order_seq >= 2 THEN 1 ELSE 0 END AS repeat_order_count
        FROM "data"."main"."order_sequence" order_sequence_src_10000
        WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'
      ) subq_3
      WHERE member in ('M00005','M00007')
      GROUP BY
        member
    ) subq_7
    FULL OUTER JOIN (
      -- Constrain Output with WHERE
      -- Select: ['__valid_order_count', 'member']
      -- Aggregate Inputs for Simple Metrics
      -- Compute Metrics via Expressions
      SELECT
        member
        , SUM(valid_order_count) AS valid_order_count
      FROM (
        -- Read Elements From Semantic Model 'orders'
        -- Metric Time Dimension 'ordered_at'
        -- Constrain Time Range to [2026-08-01T00:00:00, 2026-08-31T00:00:00]
        -- Select: ['__valid_order_count', 'member']
        SELECT
          member_id AS member
          , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS valid_order_count
        FROM "data"."main"."orders" orders_src_10000
        WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'
