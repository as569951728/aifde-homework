(date_trunc('month', o.ordered_at) AS DATE) AS month_start,\n    o.paid_cents - o.refund_cents AS net_sales_cents\n  FROM \"data\".\"main\".\"orders\" o\n  WHERE o.status = 'paid' AND o.paid_cents - o.refund_cents > 0\n),\nmonthly AS (\n  SELECT\n    member_id,\n    month_start,\n    COUNT(*) AS valid_order_count,\n    SUM(net_sales_cents) AS net_sales_cents\n  FROM valid_orders\n  GROUP BY member_id, month_start\n)\nSELECT\n  member_id,\n  month_start,\n  member_id || '|' || CAST(month_start AS VARCHAR) AS member_month_key,\n  valid_order_count,\n  net_sales_cents\nFROM monthly", "relation_name": "\"data\".\"main\".\"monthly_member_fact\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T15:16:37.211419Z", "completed_at": "2026-11-08T15:16:37.212810Z"}, {"name": "execute", "started_at": "2026-11-08T15:16:37.213027Z", "completed_at": "2026-11-08T15:16:37.224980Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.015630006790161133, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.w03.order_sequence", "compiled": true, "compiled_code": "WITH valid_orders AS (\n  SELECT\n    o.*,\n    ROW_NUMBER() OVER (PARTITION BY o.member_id ORDER BY o.ordered_at, o.order_id) AS valid_order_seq\n  FROM \"data\".\"main\".\"orders\" o\n  WHERE o.status = 'paid' AND o.paid_cents - o.refund_cents > 0\n)\nSELECT * FROM valid_orders", "relation_name": "\"data\".\"main\".\"order_sequence\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.21161484718322754, "args": {"log_file_max_bytes": 10485760, "show_resource_report": false, "validate_macro_args": true, "exclude": [], "support_custom_ref_kwargs": false, "state_modified_compare_vars": false, "version_check": true, "require_yaml_configuration_for_mf_time_spines": true, "which": "run", "allow_jinja_file_extensions": false, "favor_state": false, "warn_error_options": {"error": [], "warn"