-- Write to DataTable
SELECT
  COALESCE(subq_7.member, subq_15.member, subq_23.member) AS member
  , MAX(subq_7.first_buyer_count) AS first_buyer_count
  , MAX(subq_7.first_order_sales_cents) AS first_order_sales_cents
  , MAX(subq_7.first_order_count) AS first_order_count
  , MAX(subq_15.repeat_order_count) AS repeat_order_count
  , MAX(subq_23.valid_order_count) AS valid_order_count
FROM (
  -- Constrain Output with WHERE
  -- Select: ['__first_buyer_count', '__first_order_sales_cents', '__first_order_count', 'member']
  -- Aggregate Inputs for Simple Metrics
  -- Compute Metrics via Expressions
  SELECT
    member
    , COUNT(DISTINCT first_buyer_count) AS first_buyer_count
    , SUM(first_order_sales_cents) AS first_order_sales_cents
    , SUM(first_order_count) AS first_order_count
  FROM (
    -- Read Elements From Semantic Model 'first_valid_orders'
    -- Metric Time Dimension 'first_order_date'
    -- Constrain Time Range to [2026-08-01T00:00:00, 2026-08-31T00:00:00]
    -- Select: ['__first_buyer_count', '__first_order_sales_cents', '__first_order_count', 'member']
    SELECT
      member_id AS member
      , member_id AS first_buyer_count
      , net_sales_cents AS first_order_sales_cents
      , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS first_order_count
    FROM "data"."main"."first_valid_orders" first_valid_orders_src_10000
    WHERE DATE_TRUNC('day', first_order_date) BETWEEN '2026-08-01' AND '2026-08-31'
  ) subq_3
  WHERE member in ('M00005','M00007')
  GROUP BY
    member
) subq_7
FULL OUTER JOIN (
  -- Constrain Output with WHERE
  -- Select: ['__repeat_order_count', 'member']
  -- Aggregate Inputs for Simple Metrics
  -- Compute Metrics via Expressions
  SELECT
    member
    , SUM(repeat_order_count) AS repeat_order_count
  FROM (
    -- Read Elements From Semantic Model 'repeat_valid_orders'
    -- Metric Time Dimension 'ordered_at'
    -- Constrain Time Range to [2026-08-01T00:00:00, 2026-08-31T00:00:00]
    -- Select: ['__repeat_order_count', 'member']
    SELECT
      member_id AS member
      , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS repeat_order_count
    FROM "data"."main"."repeat_valid_orders" repeat_valid_orders_src_10000
    WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'
  ) subq_11
  WHERE member in ('M00005','M00007')
  GROUP BY
    member
) subq_15
ON
  subq_7.member = subq_15.member
FULL OUTER JOIN (
  -- Constrain Output with WHERE
  -- Select: ['__valid_order_count', 'member']
  -- Aggregate Inputs for Simple Metrics
  -- Compute Metrics via Expressions
  SELECT
    member
    , SUM(valid_order_count) AS valid_order_count
  FROM (
    -- Read Elements From Semantic Model 'orders'
    -- Metric Time Dimension 'ordered_at'
    -- Constrain Time Range to [2026-08-01T00:00:00, 2026-08-31T00:00:00]
    -- Select: ['__valid_order_count', 'member']
    SELECT
      member_id AS member
      , CASE WHEN case when status = 'paid' and paid_cents - refund_cents > 0 then order_id else null end IS NOT NULL THEN 1 ELSE 0 END AS valid_order_count
    FROM "data"."main"."orders" orders_src_10000
    WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'
  ) subq_19
  WHERE member in ('M00005','M00007')
  GROUP BY
    member
) subq_23
ON
  COALESCE(subq_7.member, subq_15.member) = subq_23.member
GROUP BY
  COALESCE(subq_7.member, subq_15.member, subq_23.member)
