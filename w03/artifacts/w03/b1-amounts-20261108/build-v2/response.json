  "unresolved": [],
  "business_model_usage": [
    {
      "quote": "一行一笔订单。保留订单识别、关联账户、渠道（门店或小程序）、下单日期、支付状态、原价、实付、累计退款、原始购买件数的含义。",
      "used_for": [
        {
          "kind": "semantic_model",
          "name": "orders_model"
        },
        {
          "kind": "dimension",
          "name": "order__channel"
        },
        {
          "kind": "dimension",
          "name": "order__status"
        }
      ]
    },
    {
      "quote": "本期字典给出：账户—卡为一对多，账户—订单为一对多，卡与订单均关联账户。本期材料不提供订单与具体卡的对应，不据卡数复制订单，也不据订单反推卡。",
      "used_for": [
        {
          "kind": "semantic_model",
          "name": "orders_model"
        },
        {
          "kind": "semantic_model",
          "name": "members_model"
        }
      ]
    },
    {
      "quote": "会员归属门店描述账户归属；订单成交门店描述交易发生门店，两者是不同关系，不可互相替代",
      "used_for": [
        {
          "kind": "semantic_model",
          "name": "store_model"
        },
        {
          "kind": "semantic_model",
          "name": "home_store_model"
        },
        {
          "kind": "dimension",
          "name": "store"
        },
        {
          "kind": "dimension",
          "name": "home_store"
        },
        {
          "kind": "dimension",
          "name": "store__region"
        },
        {
          "kind": "dimension",
          "name": "store__store_name"
        },
        {
          "kind": "dimension",
          "name": "home_store__region"
        },
        {
          "kind": "dimension",
          "name": "home_store__store_name"
        }
      ]
    },
    {
      "quote": "一行一份 CRM 会员账户；账户不等于跨系统自然人，也不等于自然人数。属性含注册日期、归属门店、会员等级",
      "used_for": [
        {
          "kind": "semantic_model",
