        "sql": "SELECT\n  CAST(SUM(net_sales_cents) AS DOUBLE) / CAST(NULLIF(SUM(valid_order_count), 0) AS DOUBLE) AS avg_order_value\n  , CAST(SUM(net_sales_cents) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT buyer_count), 0) AS DOUBLE) AS avg_buyer_value\n  , CAST(SUM(valid_order_count) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT buyer_count), 0) AS DOUBLE) AS purchase_frequency\n  , CAST(SUM(refund_cents) AS DOUBLE) / CAST(NULLIF(SUM(payment_cents), 0) AS DOUBLE) AS refund_amount_rate\n  , CAST(SUM(cancelled_order_count) AS DOUBLE) / CAST(NULLIF(SUM(order_count), 0) AS DOUBLE) AS cancel_rate\n  , CAST(SUM(refund_order_count) AS DOUBLE) / CAST(NULLIF(SUM(paid_order_count), 0) AS DOUBLE) AS refund_order_rate\n  , CAST(SUM(discount_cents) AS DOUBLE) / CAST(NULLIF(SUM(gross_cents), 0) AS DOUBLE) AS discount_rate\n  , CAST(SUM(valid_order_items) AS DOUBLE) / CAST(NULLIF(SUM(valid_order_count), 0) AS DOUBLE) AS items_per_order\nFROM (\n  SELECT\n    channel AS order__channel\n    , 1 AS order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id END AS buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS valid_order_items\n  FROM \"data\".\"main\".\"orders\" orders_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'\n) subq_15\nWHERE order__channel in ('小程序')",
