        "sql": "SELECT\n  store\n  , CAST(net_sales_cents AS DOUBLE) / CAST(NULLIF(valid_order_count, 0) AS DOUBLE) AS avg_order_value\n  , CAST(net_sales_cents AS DOUBLE) / CAST(NULLIF(buyer_count, 0) AS DOUBLE) AS avg_buyer_value\n  , CAST(valid_order_count AS DOUBLE) / CAST(NULLIF(buyer_count, 0) AS DOUBLE) AS purchase_frequency\n  , CAST(refund_cents AS DOUBLE) / CAST(NULLIF(payment_cents, 0) AS DOUBLE) AS refund_amount_rate\n  , CAST(cancelled_order_count AS DOUBLE) / CAST(NULLIF(order_count, 0) AS DOUBLE) AS cancel_rate\n  , CAST(refund_order_count AS DOUBLE) / CAST(NULLIF(paid_order_count, 0) AS DOUBLE) AS refund_order_rate\n  , CAST(discount_cents AS DOUBLE) / CAST(NULLIF(gross_cents, 0) AS DOUBLE) AS discount_rate\n  , CAST(valid_order_items AS DOUBLE) / CAST(NULLIF(valid_order_count, 0) AS DOUBLE) AS items_per_order\nFROM (\n  SELECT\n    store\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n    , SUM(__refund_cents) AS refund_cents\n    , SUM(__payment_cents) AS payment_cents\n    , SUM(__cancelled_order_count) AS cancelled_order_count\n    , SUM(__order_count) AS order_count\n    , SUM(__refund_order_count) AS refund_order_count\n    , SUM(__paid_order_count) AS paid_order_count\n    , SUM(__discount_cents) AS discount_cents\n    , SUM(__gross_cents) AS gross_cents\n    , SUM(__valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      store_id AS store\n      , 1 AS __order_count\n      , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n      , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n      , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n      , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n      , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n      , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n      , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n      , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n      , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n      , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id END AS __buyer_count\n      , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n    FROM \"data\".\"main\".\"orders\" orders_src_10000\n    WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-07-01' AND '2026-07-31'\n  ) subq_16\n  GROUP BY\n    store\n) subq_18",
