  "sql": "WITH sma_10004_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , store_id AS store\n    , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS __order_count\n    , CASE WHEN case when status = 'paid' then order_id end IS NOT NULL THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN case when status = 'paid' and paid_cents - refund_cents > 0 then order_id end IS NOT NULL THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN case when status = 'cancelled' then order_id end IS NOT NULL THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN case when status = 'paid' and refund_cents > 0 then order_id end IS NOT NULL THEN 1 ELSE 0 END AS __refund_order_count\n    , case when status = 'paid' then paid_cents else 0 end AS __payment_cents\n    , case when status = 'paid' then refund_cents else 0 end AS __refund_cents\n    , case when status = 'paid' then paid_cents - refund_cents else 0 end AS __net_sales_cents\n    , case when status = 'paid' then gross_cents else 0 end AS __gross_cents\n    , case when status = 'paid' then gross_cents - paid_cents else 0 end AS __discount_cents\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then member_id end AS __buyer_count\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then quantity else 0 end AS __valid_order_items\n  FROM \"data\".\"main\".\"orders_enriched\" orders_src_10000\n)\n\nSELECT\n  COALESCE(subq_18.store, subq_24.store) AS store\n  , MAX(subq_18.net_sales_cents) AS net_sales_cents\n  , MAX(subq_18.valid_order_count) AS valid_order_count\n  , MAX(subq_18.buyer_count) AS buyer_count\n  , MAX(CAST(subq_24.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_24.valid_order_count, 0) AS DOUBLE)) AS avg_order_value\n  , MAX(CAST(subq_24.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_24.buyer_count, 0) AS DOUBLE)) AS avg_buyer_value\n  , MAX(CAST(subq_24.valid_order_count AS DOUBLE) / CAST(NULLIF(subq_24.buyer_count, 0) AS DOUBLE)) AS purchase_frequency\n  , MAX(CAST(subq_24.refund_cents AS DOUBLE) / CAST(NULLIF(subq_24.payment_cents, 0) AS DOUBLE)) AS refund_amount_rate\n  , MAX(CAST(subq_24.cancelled_order_count AS DOUBLE) / CAST(NULLIF(subq_24.order_count, 0) AS DOUBLE)) AS cancel_rate\n  , MAX(CAST(subq_24.refund_order_count AS DOUBLE) / CAST(NULLIF(subq_24.paid_order_count, 0) AS DOUBLE)) AS refund_order_rate\n  , MAX(CAST(subq_24.discount_cents AS DOUBLE) / CAST(NULLIF(subq_24.gross_cents, 0) AS DOUBLE)) AS discount_rate\n  , MAX(CAST(subq_24.valid_order_items AS DOUBLE) / CAST(NULLIF(subq_24.valid_order_count, 0) AS DOUBLE)) AS items_per_order\nFROM (\n  SELECT\n    store\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n  FROM sma_10004_cte\n  WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  GROUP BY\n    store\n) subq_18\nFULL OUTER JOIN (\n  SELECT\n    store\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n    , SUM(__refund_cents) AS refund_cents\n    , SUM(__payment_cents) AS payment_cents\n    , SUM(__cancelled_order_count) AS cancelled_order_count\n    , SUM(__order_count) AS order_count\n    , SUM(__refund_order_count) AS refund_order_count\n    , SUM(__paid_order_count) AS paid_order_count\n    , SUM(__discount_cents) AS discount_cents\n    , SUM(__gross_cents) AS gross_cents\n    , SUM(__valid_order_items) AS valid_order_items\n  FROM sma_10004_cte\n  WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  GROUP BY\n    store\n) subq_24\nON\n  subq_18.store = subq_24.store\nGROUP BY\n  COALESCE(subq_18.store, subq_24.store)",
