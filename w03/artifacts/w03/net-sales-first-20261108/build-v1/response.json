{
  "semantic_models": [
    {
      "name": "orders",
      "model": "ref('orders')",
      "defaults": {
        "agg_time_dimension": "ordered_at"
      },
      "entities": [
        {
          "name": "order",
          "type": "primary",
          "expr": "order_id"
        },
        {
          "name": "member",
          "type": "foreign",
          "expr": "member_id"
        },
        {
          "name": "store",
          "type": "foreign",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "ordered_at",
          "type": "time",
          "type_params": {
            "time_granularity": "day"
          }
        },
        {
          "name": "channel",
          "type": "categorical"
        },
        {
          "name": "status",
          "type": "categorical"
        }
      ],
      "measures": [
        {
          "name": "net_sales_cents_measure",
          "expr": "CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END",
          "agg": "sum"
        }
      ]
    },
    {
      "name": "members",
      "model": "ref('members')",
      "entities": [
        {
          "name": "member",
          "type": "primary",
          "expr": "member_id"
        },
        {
          "name": "home_store",
          "type": "foreign",
          "expr": "home_store_id"
        }
      ],
      "dimensions": [
        {
          "name": "tier",
          "type": "categorical"
        }
      ],
      "measures": []
    },
    {
      "name": "stores",
      "model": "ref('stores')",
      "entities": [
        {
          "name": "store",
          "type": "primary",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "region",
          "type": "categorical"
        },
        {
          "name": "store_name",
          "type": "categorical"
        }
      ],
      "measures": []
    },
    {
      "name": "home_stores",
      "model": "ref('stores')",
      "entities": [
        {
          "name": "home_store",
          "type": "primary",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "region",
          "type": "categorical"
        },
        {
          "name": "store_name",
          "type": "categorical"
        }
      ],
      "measures": []
    }
  ],
  "metrics": [
    {
      "name": "net_sales_cents",
      "label": "净销售额",
      "description": "paid 订单实付减退款后合计；取消单不计；按原订单下单日期归属；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "net_sales_cents_measure"
      }
    }
  ],
  "catalog": [
    {
      "id": "net_sales_cents",
      "name": "净销售额",
      "aliases": [],
      "unit": "分",
      "sources": [
        {
          "file": "01_订单日报说明.md",
          "quote": "paid 订单实付减退款后合计；取消单不计；按原订单下单日期归属；单位分。"
        },
        {
          "file": "02_财务邮件.md",
          "quote": "有效订单是 paid 状态且实付大于累计退款；取消、全额退款不计有效购买。退款按原订单日期归属。金额为整数分，展示元需换算。"
        }
      ],
      "constraints": [
        "paid 状态订单计入；取消单不计",
        "退款按原订单下单日期归属",
        "金额为整数分"
      ],
      "query_policy": {
        "full_month_only": false
      }
    }
  ],
