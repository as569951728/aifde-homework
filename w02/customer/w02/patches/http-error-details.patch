+def public_http_error(exc, key):
+    """Keep bounded provider diagnostics, never raw bodies or echoed credentials."""
+    try:
+        raw = exc.read(8193)
+    except (OSError, ValueError, http.client.HTTPException):
+        return {"detail_unavailable": "read_failed"}
+    if len(raw) > 8192:
+        return {"detail_unavailable": "body_too_large"}
+    try:
+        body = json.loads(raw)
+    except (ValueError, UnicodeError):
+        return {"detail_unavailable": "non_json_body"}
+    detail = body.get("error", body) if isinstance(body, dict) else None
+    if not isinstance(detail, dict):
+        return {"detail_unavailable": "unrecognized_body"}
+    result = {}
+    for field in ("message", "type", "code", "param"):
+        value = detail.get(field)
+        if isinstance(value, str):
+            for secret in (key, quote(key, safe="")):
+                if secret:
+                    value = value.replace(secret, "[REDACTED]")
+            result[field] = value[:1000]
+        elif type(value) is int:
+            result[field] = value
+    return result or {"detail_unavailable": "unrecognized_body"}
 
