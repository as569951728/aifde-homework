+def test_http_error_retains_reason_without_echoed_key_or_raw_body_and_never_retries():
+    m=make();m.key='LOCAL_PRIVATE_KEY/+='
+    error_body={'error':{'message':'Invalid '+m.key+' or '+quote(m.key,safe=''),
+                        'type':'invalid_request_error','code':'invalid_parameter','param':'tools',
+                        'request_headers':{'Authorization':'Bearer '+m.key},
+                        'reasoning_content':'PRIVATE_REASONING'}}
+    stream=io.BytesIO(json.dumps(error_body).encode())
+    failure=HTTPError(m.url,400,'Bad Request',{},stream)
+    with patch.object(m,'_send',side_effect=failure) as send:
+        with pytest.raises(ModelError,match='MODEL_HTTP_400'):m.complete([],[])
+        assert send.call_count==1
+    detail=m.last_call['attempts'][0]['provider_error']
+    assert detail=={'message':'Invalid [REDACTED] or [REDACTED]',
+                    'type':'invalid_request_error','code':'invalid_parameter','param':'tools'}
+    saved=json.dumps(m.last_call)
+    assert m.key not in saved and quote(m.key,safe='') not in saved
+    assert 'PRIVATE_REASONING' not in saved and 'request_headers' not in saved
+    assert stream.closed
+
+
+@pytest.mark.parametrize('raw,reason',[
+    (b'<html>PRIVATE_KEY</html>','non_json_body'),
+    (b'x'*8193,'body_too_large'),
+    (b'["PRIVATE_KEY"]','unrecognized_body'),
+    (b'{"unexpected":"PRIVATE_KEY"}','unrecognized_body')])
+def test_http_error_unparseable_bodies_are_not_dumped(raw,reason):
+    m=make();stream=io.BytesIO(raw)
+    with patch.object(m,'_send',side_effect=HTTPError(m.url,400,'Bad Request',{},stream)):
+        with pytest.raises(ModelError,match='MODEL_HTTP_400'):m.complete([],[])
+    assert m.last_call['attempts'][0]['provider_error']=={'detail_unavailable':reason}
+    assert 'PRIVATE_KEY' not in json.dumps(m.last_call)
+    assert stream.closed
